# .env.example — GymControl
#
# ATENÇÃO: o configuration.php lê essas variáveis via getenv(), que busca
# variáveis de AMBIENTE do sistema — não lê este arquivo automaticamente,
# pois o projeto não usa nenhuma biblioteca de dotenv (ex: vlucas/phpdotenv).
# Ou seja: só copiar isso para ".env" NÃO vai mudar o comportamento do sistema.
#
# Se não fizer nada, o sistema usa estes valores padrão (já definidos no código):
#   DB_NAME=academia | DB_USER=root | DB_PASSWORD= | DB_HOST=localhost | DB_PORT=3306
#
# Isso é documentação de referência. Só tem efeito real se as variáveis forem
# exportadas no ambiente (ex: "export DB_NAME=academia" no terminal/servidor).

DB_NAME=academia
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
